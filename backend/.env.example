# ---------------------------------------------------------------------------
# TerraTrace AI — environment configuration
# Copy this file to `backend/.env` (or the project root) and fill in what you
# have. Every value is optional: TerraTrace runs fully anonymously against NASA
# CMR, Microsoft Planetary Computer and AWS Earth Search, and reports honestly
# which capabilities are therefore unavailable.
# ---------------------------------------------------------------------------

# --- application ---
LOG_LEVEL=INFO
DEBUG=false
# DATABASE_URL=sqlite:///D:/nasa finalist/backend/terratrace.db
JOB_WORKERS=2
AGENT_MAX_WORKERS=4
AGENT_TIMEOUT_S=120
AGENT_RETRIES=1
RASTER_SIZE=768
MAX_OBSERVATIONS=6

# --- NASA Earthdata Login (server side; never exposed to the browser) -------
# Enables download of NISAR / OPERA science rasters (metadata works without it).
# Create a token at https://urs.earthdata.nasa.gov/profile
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# --- Copernicus Data Space (optional, for DSWx/albedo style products) -------
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- NASA FIRMS active-fire context (optional) -----------------------------
# Get a key at https://firms.modaps.eosdis.nasa.gov/api/active_fire/
FIRMS_MAP_KEY=

# --- connector switches ----------------------------------------------------
ENABLE_CMR=true
ENABLE_PLANETARY_COMPUTER=true
ENABLE_EARTH_SEARCH=true
ENABLE_COPERNICUS=true

# --- Supabase (database + storage) -----------------------------------------
# Create a free project at https://supabase.com
# Database URL: Settings → Database → Connection string (URI mode)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key
# SUPABASE_STORAGE_BUCKET=terratrace-artifacts
# USE_SUPABASE_STORAGE=true
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
